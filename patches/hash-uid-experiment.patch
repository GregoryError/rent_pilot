@@ -177,4 +177,67 @@ class ICalExportEventsTest {
                 .containsExactly("199904867");
         assertThat(feed(List.of(), List.of(shadow), 8L)).isEmpty();
     }
+
+    /** MD5("optirent-manual-100-2026-12-01-2026-12-02"), посчитан независимо от кода. */
+    private static String expectedHash() throws Exception {
+        byte[] d = java.security.MessageDigest.getInstance("MD5").digest(
+                "optirent-manual-100-2026-12-01-2026-12-02".getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        StringBuilder sb = new StringBuilder();
+        for (byte x : d) sb.append(String.format("%02x", x));
+        return sb.toString();
+    }
+
+    private static CalendarBlock manual100() {
+        CalendarBlock b = block(100, null, null, 1, 2);
+        b.setFromDate(LocalDate.of(2026, 12, 1));
+        b.setToDate(LocalDate.of(2026, 12, 2));
+        return b;
+    }
+
+    @Test
+    @DisplayName("канал с UID-хэшем: ручная запись уходит с MD5 от optirent-manual-<id>-<from>-<to>")
+    void hashUidForChannelWithHashFormat() throws Exception {
+        List<ICalWriter.BusyPeriod> events = AvailabilityService.buildExportEvents(
+                List.of(), List.of(manual100(), block(7, 9L, "199904867", 12, 14)), List.of(), 8L, true);
+
+        assertThat(events).extracting(ICalWriter.BusyPeriod::uid)
+                .containsExactlyInAnyOrder(expectedHash(), "199904867");
+        assertThat(expectedHash()).matches("[0-9a-f]{32}");
+        // детерминированность: повторный экспорт даёт тот же UID
+        assertThat(manual100().manualHashUid()).isEqualTo(expectedHash());
+    }
+
+    @Test
+    @DisplayName("обычный канал: та же ручная запись уходит с optirent-manual-<id>@optirent.ru")
+    void markerUidForOrdinaryChannel() {
+        List<ICalWriter.BusyPeriod> events = AvailabilityService.buildExportEvents(
+                List.of(), List.of(manual100()), List.of(), 9L, false);
+
+        assertThat(events).extracting(ICalWriter.BusyPeriod::uid)
+                .containsExactly("optirent-manual-100@optirent.ru");
+    }
+
+    @Test
+    @DisplayName("канал с UID-хэшем: удалённая запись — тот же хэш, STATUS:CANCELLED, SEQUENCE:1")
+    void cancelledManualKeepsHashUid() throws Exception {
+        CalendarBlock cancelled = manual100();
+        cancelled.setCancelledAt(java.time.LocalDateTime.now());
+
+        String ics = ICalWriter.write("Тест", AvailabilityService.buildExportEvents(
+                List.of(), List.of(), List.of(cancelled), 8L, true));
+
+        assertThat(ics).contains("UID:" + expectedHash())
+                .contains("STATUS:CANCELLED").contains("SEQUENCE:1").contains("TRANSP:TRANSPARENT");
+        assertThat(ICalParser.parse(ics)).singleElement()
+                .satisfies(ev -> assertThat(ev.cancelled()).isTrue());
+    }
+
+    @Test
+    @DisplayName("смена дат ручной записи меняет UID-хэш")
+    void hashDependsOnDates() {
+        CalendarBlock moved = manual100();
+        moved.setToDate(LocalDate.of(2026, 12, 3));
+
+        assertThat(moved.manualHashUid()).isNotEqualTo(manual100().manualHashUid());
+    }
 }
