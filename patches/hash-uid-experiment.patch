+    /** Домен собственных UID в iCal-экспорте. */
+    public static final String UID_DOMAIN = "optirent.ru";
+
+    /** UID ручной записи в обычном формате: {@code optirent-manual-<id>@optirent.ru}. */
+    public String manualUid() {
+        return MANUAL_UID_PREFIX + id + "@" + UID_DOMAIN;
+    }
+
+    /**
+     * UID ручной записи в формате хэша — для площадок, которые не принимают UID вида
+     * «имя@домен»: MD5 от {@code optirent-manual-<id>-<from>-<to>}, 32 hex-символа.
+     * Даты входят в ключ: если у записи изменятся даты, площадка увидит новое событие.
+     */
+    public String manualHashUid() {
+        String seed = MANUAL_UID_PREFIX + id + "-" + fromDate + "-" + toDate;
+        try {
+            byte[] digest = java.security.MessageDigest.getInstance("MD5")
+                    .digest(seed.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            return java.util.HexFormat.of().formatHex(digest);
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e); // MD5 есть в любой JRE
+        }
+    }
