@@ -0,0 +1,78 @@
+package ru.rentoptima.service;
+
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import ru.rentoptima.channel.ical.ICalWriter;
+import ru.rentoptima.entity.CalendarBlock;
+import ru.rentoptima.entity.UnitType;
+import ru.rentoptima.repository.BookingRepository;
+import ru.rentoptima.repository.CalendarBlockRepository;
+
+import java.time.LocalDate;
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.when;
+
+/**
+ * Экспорт через сервис целиком (репозитории — моки): формат UID ручной записи
+ * зависит от настройки канала-получателя. Теста с настоящей базой нет — локально
+ * её не поднять, см. CLAUDE.md.
+ */
+@ExtendWith(MockitoExtension.class)
+@DisplayName("AvailabilityService.exportEvents: формат UID ручных записей")
+class AvailabilityServiceExportUidTest {
+
+    @Mock BookingRepository bookingRepo;
+    @Mock CalendarBlockRepository blockRepo;
+    @InjectMocks AvailabilityService service;
+
+    private static final LocalDate FROM = LocalDate.of(2026, 11, 1);
+    private static final LocalDate TO = LocalDate.of(2027, 1, 1);
+
+    private static UnitType unitType() {
+        UnitType ut = new UnitType();
+        ut.setId(3L);
+        ut.setUnitCount(1);
+        return ut;
+    }
+
+    private void manualInDb() {
+        CalendarBlock manual = new CalendarBlock();
+        manual.setId(271L);
+        manual.setUnitTypeId(3L);
+        manual.setBlockType(CalendarBlock.BlockType.MANUAL_BOOKING);
+        manual.setFromDate(LocalDate.of(2026, 12, 4));
+        manual.setToDate(LocalDate.of(2026, 12, 5));
+        when(bookingRepo.findActiveByUnitTypesInRange(any(), any(), any())).thenReturn(List.of());
+        when(blockRepo.findByUnitTypesInRange(any(), any(), any())).thenReturn(List.of(manual));
+        when(blockRepo.findCancelledByUnitTypesInRange(any(), any(), any())).thenReturn(List.of());
+    }
+
+    @Test
+    @DisplayName("канал с UID-хэшем получает 32 hex-символа")
+    void hashChannel() {
+        manualInDb();
+
+        List<ICalWriter.BusyPeriod> events = service.exportEvents(unitType(), FROM, TO, 8L, true);
+
+        assertThat(events).singleElement()
+                .satisfies(e -> assertThat(e.uid()).matches("[0-9a-f]{32}"));
+    }
+
+    @Test
+    @DisplayName("обычный канал получает optirent-manual-<id>@optirent.ru")
+    void ordinaryChannel() {
+        manualInDb();
+
+        List<ICalWriter.BusyPeriod> events = service.exportEvents(unitType(), FROM, TO, 7L);
+
+        assertThat(events).singleElement()
+                .satisfies(e -> assertThat(e.uid()).isEqualTo("optirent-manual-271@optirent.ru"));
+    }
+}
