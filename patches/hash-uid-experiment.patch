+        verify(echoRepo).save(echo.capture());
+        assertThat(echo.getValue().getManualBlockId()).isEqualTo(265L);
+    }
+
+    @Test
+    @DisplayName("UID-хэш удалённой ручной записи тоже пропускается — она ещё уходит в фид отменённой")
+    void ownHashUidOfCancelledManual_skipped() {
+        CalendarBlock manual = manual(265L, 30);
+        manual.setCancelledAt(LocalDateTime.now());
+        when(blockRepo.findHandMadeInRange(eq(UNIT_TYPE_ID), any(), any())).thenReturn(List.of(manual));
+        when(blockRepo.findByChannelInRange(eq(CHANNEL_ID), any(), any())).thenReturn(List.of());
+
+        ChannelSyncResult result = adapter.reconcile(ctx(),
+                List.of(event(manual.manualHashUid(), ECHO_FROM, ECHO_TO, false)));
+
+        assertThat(result.imported()).isZero();
+        verify(blockRepo, never()).save(any());
+    }
+
+    @Test
+    @DisplayName("случайный хэш на даты живой ручной записи → тень по датам, как раньше")
+    void foreignHashSameDates_importedAsShadow() {
+        CalendarBlock manual = manual(265L, 0);
+        manualBlocksInDb(manual);
+        when(blockRepo.findHandMadeInRange(eq(UNIT_TYPE_ID), any(), any())).thenReturn(List.of(manual));
+        when(blockRepo.findByChannelIdAndExternalUid(CHANNEL_ID, "2bb640df35d95607cbcb609bd8b02c3b"))
+                .thenReturn(Optional.empty());
+        when(blockRepo.findByChannelInRange(eq(CHANNEL_ID), any(), any())).thenReturn(List.of());
+
+        ChannelSyncResult result = adapter.reconcile(ctx(),
+                List.of(event("2bb640df35d95607cbcb609bd8b02c3b", ECHO_FROM, ECHO_TO, false)));
+
+        assertThat(result.imported()).isEqualTo(1);
+        ArgumentCaptor<CalendarBlock> block = ArgumentCaptor.forClass(CalendarBlock.class);
+        verify(blockRepo).save(block.capture());
+        assertThat(block.getValue().getShadowOfManualId()).isEqualTo(265L);
+    }
 }
