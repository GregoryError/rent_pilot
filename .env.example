DB_PASSWORD=change_me_to_strong_password
APP_PORT=8080

# Почта (Unisender Go): письма гостям о бронях, сброс пароля, подтверждение адреса.
# Пока SMTP_HOST и MAIL_FROM пустые, письма не отправляются.
SMTP_HOST=smtp.go2.unisender.ru
SMTP_PORT=587
# starttls (587) или ssl (465); пусто — по порту
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=OptiRent <no-reply@optirent.ru>
# Куда приходят ответы на письма (на no-reply письма не принимаются)
MAIL_REPLY_TO=
# 1 — без ссылки отписки в письмах; только после того, как это включила поддержка Unisender
MAIL_SKIP_UNSUBSCRIBE=0

# Окружение: поисковики индексируют только prod. Без переменной сайт закрыт от индексации.
APP_ENVIRONMENT=prod
# Подтверждение прав на сайт: значение content из meta-тега Яндекс.Вебмастера и Google
# Search Console. Пусто — тег не выводится.
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=
# Ключ IndexNow (например, `openssl rand -hex 16`). Пусто — уведомления поисковикам не шлются.
INDEXNOW_KEY=
# Счётчик Яндекс.Метрики сайта (только цифры). Загружается после согласия посетителя в
# баннере о cookie. Пусто — ни Метрики, ни баннера.
METRIKA_ID=
