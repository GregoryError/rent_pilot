DB_PASSWORD=change_me_to_strong_password
APP_PORT=8080
# Порт приложения на 127.0.0.1 (docker-compose.yml), по умолчанию 8081
STAGING_APP_PORT=8081

# Почта (Unisender Go): письма гостям о бронях, сброс пароля, подтверждение адреса.
# Пока SMTP_HOST и MAIL_FROM пустые, письма не отправляются.
SMTP_HOST=smtp.go2.unisender.ru
SMTP_PORT=587
# starttls (587) или ssl (465); пусто — по порту
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=OptiRent <no-reply@optirent.ru>
# Куда приходят ответы на письма (на no-reply письма не принимаются)
MAIL_REPLY_TO=
# 1 — без ссылки отписки в письмах; только после того, как это включила поддержка Unisender
MAIL_SKIP_UNSUBSCRIBE=0

# Окружение: поисковики индексируют только prod. В docker-compose.yml по умолчанию staging.
APP_ENVIRONMENT=prod
# Адрес сайта — единственный источник для canonical, sitemap, IndexNow, ссылок фидов, QR,
# ссылок горничной и отзывов, писем и Telegram. В docker-compose.yml по умолчанию
# https://staging.optirent.ru.
APP_BASE_URL=https://optirent.ru
# Какую ветку выкатывает scripts/deploy.sh в этой установке (по умолчанию feat/channels-mvp)
DEPLOY_BRANCH=main
# Имена контейнеров и томов. По умолчанию — как у staging до переезда. Том — это данные:
# новое имя тома = пустая база / пустой каталог фото.
#APP_CONTAINER_NAME=rentoptima-staging-app
#DB_CONTAINER_NAME=rentoptima-staging-db
#UPLOADS_VOLUME=rentoptima-staging_uploads
#PGDATA_VOLUME=rentoptima-staging_pgdata-staging
# Подтверждение прав на сайт: значение content из meta-тега Яндекс.Вебмастера и Google
# Search Console. Пусто — тег не выводится.
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=
# Ключ IndexNow (например, `openssl rand -hex 16`). Пусто — уведомления поисковикам не шлются.
INDEXNOW_KEY=
# Счётчик Яндекс.Метрики сайта (только цифры). Загружается после согласия посетителя в
# баннере о cookie. Пусто — ни Метрики, ни баннера.
METRIKA_ID=
